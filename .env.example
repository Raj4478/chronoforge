# ChronoForge environment variables
# Copy to .env.local and adjust. All are public (NEXT_PUBLIC_*) — never put secrets here.

# Canonical production origin (no trailing slash). Used for canonical URLs, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://chronoforge.app

# "true" on the production custom domain only. Anything else => noindex (dev/preview).
NEXT_PUBLIC_ALLOW_INDEX=false

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Leave blank to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# "true" to show the consent banner (required in some regions before analytics/ads load).
NEXT_PUBLIC_ENABLE_CONSENT_BANNER=true
